{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/sobre/",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/en/#about",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/en/#about",
      "permanent": true
    },
    {
      "source": "/servicos",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/servicos/",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/en/#services",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/en/#services",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/#portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "/#portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/#portfolio",
      "permanent": true
    },
    {
      "source": "/en/portfolio",
      "destination": "/en/#portfolio",
      "permanent": true
    },
    {
      "source": "/en/portfolio/",
      "destination": "/en/#portfolio",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/contato/",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en/#contact",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/en/#contact",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/duvidas",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/duvidas/",
      "destination": "/#faq",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(assets|css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
